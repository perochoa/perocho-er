---
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-600.css";
import "@fontsource/ibm-plex-sans/latin-700.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
	title: string;
	description: string;
	// Pages that shouldn't show up in search (form results, 404): no canonical, no og:url.
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en-CA">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		{!noindex && <meta property="og:url" content={canonicalURL} />}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
	</head>
	<body>
		<SiteHeader />
		<slot />
		<SiteFooter />
		<script>
			// Fades marked blocks in as they scroll into view. Only with JS and without reduced motion: the
			// class goes on <html> here, so without it everything is simply there.
			const motion = matchMedia("(prefers-reduced-motion: no-preference)");
			const blocks = document.querySelectorAll<HTMLElement>("[data-reveal]");
			if (motion.matches && "IntersectionObserver" in window && blocks.length) {
				document.documentElement.classList.add("reveal-on");
				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							entry.target.classList.add("is-in");
							observer.unobserve(entry.target);
						}
					},
					{ rootMargin: "0px 0px -8% 0px" },
				);
				blocks.forEach((block) => observer.observe(block));
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light dark;
		--bg: #f4f7f7;
		--surface: #ffffff;
		--ink: #12201f;
		--muted: #566866;
		--line: #d9e2e1;
		--accent: #0f766e;
		--on-accent: #ffffff;
		--font-sans: "IBM Plex Sans", system-ui, sans-serif;
		--font-mono: "IBM Plex Mono", ui-monospace, monospace;
		font-family: var(--font-sans);
		line-height: 1.5;
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #0e1514;
			--surface: #162120;
			--ink: #e3eceb;
			--muted: #93a5a3;
			--line: #23302f;
			--accent: #2dd4bf;
			--on-accent: #0e1514;
		}
	}
	html {
		scroll-padding-top: 5rem;
	}
	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
		/* Same-site page loads cross-fade where the browser supports it; elsewhere nothing changes. */
		@view-transition {
			navigation: auto;
		}
		/* An animation, not a transition, so it leaves the blocks' own hover transitions alone. */
		.reveal-on [data-reveal]:not(.is-in) {
			opacity: 0;
		}
		.reveal-on [data-reveal].is-in {
			animation: reveal 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
			/* Siblings set --i to come in one after another. */
			animation-delay: calc(var(--i, 0) * 80ms);
		}
	}
	@keyframes reveal {
		from {
			opacity: 0;
			transform: translateY(1rem);
		}
	}
	::view-transition-old(root),
	::view-transition-new(root) {
		animation-duration: 0.2s;
	}
	body {
		margin: 0;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		background: var(--bg);
		color: var(--ink);
	}
	body > main {
		flex: 1;
	}
	.wrap {
		box-sizing: border-box;
		width: 100%;
		max-width: 68rem;
		margin-inline: auto;
		padding-inline: 1.25rem;
	}
	h1,
	h2,
	h3 {
		line-height: 1.15;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}
	h1 {
		font-size: clamp(2.25rem, 1.5rem + 3vw, 3.5rem);
		font-weight: 700;
		letter-spacing: -0.025em;
	}
	h2 {
		font-size: clamp(1.625rem, 1.25rem + 1.5vw, 2.25rem);
	}
	h3 {
		font-size: 1.125rem;
	}
	a {
		color: var(--accent);
	}
	.eyebrow {
		margin: 0 0 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.75rem 1.375rem;
		border: 1px solid var(--accent);
		border-radius: 0.5rem;
		background: var(--accent);
		color: var(--on-accent);
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		transition:
			background-color 0.15s,
			border-color 0.15s,
			color 0.15s,
			transform 0.1s;
	}
	.button:active {
		transform: translateY(1px) scale(0.98);
	}
	.button:hover {
		background: color-mix(in srgb, var(--accent) 85%, var(--ink));
	}
	.button.secondary {
		background: transparent;
		border-color: var(--line);
		color: var(--ink);
	}
	.button.secondary:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.button.small {
		padding: 0.5rem 1rem;
		font-size: 0.9375rem;
	}
	:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
</style>
