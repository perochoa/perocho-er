---
import Contact from "../components/Contact.astro";
import Facts from "../components/Facts.astro";
import Hero from "../components/Hero.astro";
import Repairs from "../components/Repairs.astro";
import Reviews from "../components/Reviews.astro";
import Services from "../components/Services.astro";
import Steps from "../components/Steps.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/sections.css";
import { getRepairs } from "../repairs";
import { getServices } from "../services";
import { site } from "../site";
import { homeStructuredData } from "../structured-data";

const services = await getServices();
const repairs = await getRepairs();
---

<BaseLayout
	title={`${site.name} · PS5 repairs in ${site.city}`}
	description={site.description}
	structuredData={homeStructuredData(Astro.site!, services)}
>
	<main>
		<Hero />
		<Facts />
		<Services services={services} />
		<Reviews />
		<Steps />
		<Repairs repairs={repairs} />
		<Contact />
	</main>
</BaseLayout>

<script>
	import "../scripts/card-glow";
</script>
