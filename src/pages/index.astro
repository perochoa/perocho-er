---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import HeroScene from "../components/HeroScene.astro";
import Joystick from "../components/Joystick.astro";
import Rosette from "../components/Rosette.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { marketplace } from "../reviews";
import { site } from "../site";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const renderedServices = await Promise.all(
	services.map(async (service) => ({ ...service, Content: (await render(service)).Content })),
);

const repairs = (await getCollection("repairs")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const renderedRepairs = await Promise.all(
	repairs.map(async (repair) => ({ ...repair, Content: (await render(repair)).Content })),
);

const monthFormat = new Intl.DateTimeFormat("en-CA", { month: "long", year: "numeric" });
const dayFormat = new Intl.DateTimeFormat("en-CA", { timeZone: "UTC", dateStyle: "long" });

// Only facts the site already states elsewhere; nothing invented. The rating is in the hero.
const facts = [
	{ value: "~1 hr", label: "for most stick drift fixes" },
	{ value: "Drop-off", label: site.intakeUrl ? "at any open time you pick online" : "in Mississauga" },
	{ value: "Cash", label: "or Interac e-Transfer on pickup" },
];

// Matches what the request form and the worker's emails tell customers.
const steps = site.intakeUrl
	? [
			{
				title: "Request a repair",
				text: "Fill in the form with your contact details and phone number, the device and what's wrong.",
			},
			{
				title: "Pick a drop-off time",
				text: `Choose any open time to bring it in. Need it sooner? Add a rush for $${site.rushFee} to move it to the front of the line.`,
			},
			{
				title: "Get it confirmed",
				text: "A tech reviews your request and confirms it by email, and may call you about the quote. If nobody can take it, we email you too.",
			},
			{
				title: "Drop it off",
				text: "Bring it in at your drop-off time. We work in order, rush first, and agree with you on when it'll be ready. Pay by cash or Interac e-Transfer at pickup.",
			},
		]
	: [
			{ title: "Message us", text: "On Messenger or by email, about your device and what's wrong." },
			{ title: "Get a quote", text: "We reply with a price and a time to drop it off." },
			{ title: "Drop it off", text: "Bring it in at the time we agreed. We'll tell you when it'll be ready." },
			{ title: "Pay on pickup", text: "By cash or Interac e-Transfer." },
		];
---

<BaseLayout title={site.name} description={site.description}>
	<main>
		<section class="hero">
			<HeroScene />
			<div class="wrap hero-grid">
				<div class="intro">
					<p class="eyebrow">Family-run · Drop-off in Mississauga</p>
					<h1>{site.tagline}</h1>
					<p class="lede">{site.intro}</p>
					<div class="actions">
						{
							site.intakeUrl ? (
								<>
									<a class="button" href="/request/">Request a repair</a>
									<a class="button secondary" href={site.messengerUrl}>Message us</a>
								</>
							) : (
								<>
									<a class="button" href={site.messengerUrl}>Message us</a>
									<a class="button secondary" href="#services">See prices</a>
								</>
							)
						}
					</div>
					{
						site.marketplace && (
							<a class="rating" href="#reviews">
								{marketplace.highlyRated && (
									<span class="badge">
										<Rosette />
										Highly rated on Facebook Marketplace
									</span>
								)}
								<span>
									<span class="stars" aria-hidden="true">{"★".repeat(site.marketplace.stars)}</span>{" "}
									{site.marketplace.stars} stars from {site.marketplace.ratings} ratings
									{!marketplace.highlyRated && " on Facebook Marketplace"}
								</span>
							</a>
						)
					}
				</div>

				<Joystick requestHref={site.intakeUrl ? "/request/" : ""} />
			</div>
		</section>

		<section class="facts" aria-label="At a glance">
			<ul class="wrap fact-grid">
				{
					facts.map((fact, i) => (
						<li data-reveal style={`--i: ${i}`}>
							<strong>{fact.value}</strong>
							<span>{fact.label}</span>
						</li>
					))
				}
			</ul>
		</section>

		<section id="services" class="band" aria-labelledby="services-title">
			<div class="wrap">
				<div data-reveal>
					<p class="eyebrow">Services</p>
					<h2 id="services-title">What we fix</h2>
				</div>
				<ul class="cards">
					{
						renderedServices.map(({ id, data, Content }, i) => (
							<li class="card" data-reveal style={`--i: ${i}`}>
								<h3>{data.title}</h3>
								<div class="body">
									<Content />
								</div>
								{data.perItem && (
									<div
										class="calc"
										data-price={data.perItem.price}
										data-bulk-price={data.perItem.bulkPrice}
										data-bulk-from={data.perItem.bulkFrom}
										data-item={data.perItem.item}
										hidden
									>
										<span class="calc-label" id={`calc-${id}`}>
											How many {data.perItem.item}s?
										</span>
										<div class="stepper" role="group" aria-labelledby={`calc-${id}`}>
											<button type="button" data-step="-1" aria-label={`One ${data.perItem.item} fewer`}>
												−
											</button>
											<output data-count>2</output>
											<button type="button" data-step="1" aria-label={`One ${data.perItem.item} more`}>
												+
											</button>
										</div>
										<p class="calc-total" aria-live="polite">
											<strong data-total />
											<span data-note />
										</p>
									</div>
								)}
								<p class="price">{data.price ?? "Message us for a quote"}</p>
								{site.intakeUrl && (
									<a class="ask" href={`/request/?service=${id}`}>
										Request this repair <span aria-hidden="true">→</span>
									</a>
								)}
							</li>
						))
					}
				</ul>
			</div>
		</section>

		{
			site.marketplace && (
				<section id="reviews" class="band alt" aria-labelledby="reviews-title">
					<div class="wrap">
						<div data-reveal>
							<p class="eyebrow">Reviews</p>
							<h2 id="reviews-title">What customers say</h2>
						</div>
						<div class="reviews">
							<div class="summary" data-reveal>
								<p class="score">
									<strong>{site.marketplace.stars.toFixed(1)}</strong>
									<span>
										<span class="stars" aria-hidden="true">{"★".repeat(site.marketplace.stars)}</span>
										<span>{site.marketplace.ratings} ratings on Facebook Marketplace</span>
									</span>
								</p>
								{marketplace.highlyRated && (
									<p class="badge big">
										<Rosette />
										<span>
											<strong>Highly rated</strong>
											<span>4.5 stars or higher from at least 5 buyers</span>
										</span>
									</p>
								)}
								<h3>What customers pointed out</h3>
								<ul class="strengths">
									{marketplace.strengths.map(({ label, count }, i) => (
										<li style={`--share: ${count / site.marketplace!.ratings}; --i: ${i}`}>
											<span>{label}</span>
											<span class="count">{count}</span>
											<span class="bar" aria-hidden="true" />
										</li>
									))}
								</ul>
								<a class="ask" href={site.marketplace.url}>
									See the profile on Marketplace <span aria-hidden="true">→</span>
								</a>
							</div>
							<ul class="quotes">
								{marketplace.reviews.map((review, i) => (
									<li class="card quote" data-reveal style={`--i: ${i + 1}`}>
										<figure>
											<p class="stars" role="img" aria-label={`${review.stars} out of 5 stars`}>
												{"★".repeat(review.stars)}
											</p>
											<blockquote>
												<p>{review.text}</p>
											</blockquote>
											<figcaption>
												<span class="avatar" aria-hidden="true">{review.name[0]}</span>
												<span>
													<strong>{review.name}</strong>
													<time datetime={review.date}>{dayFormat.format(new Date(review.date))}</time>
												</span>
											</figcaption>
										</figure>
										<ul class="tags" aria-label="Pointed out">
											{review.notable.map((tag) => <li>{tag}</li>)}
										</ul>
										{/* Marketplace has no link to a single review; the profile lists them under "Reviews of". */}
										<a class="source" href={site.marketplace!.url}>
											<span class="visually-hidden">{review.name}'s review </span>On Facebook Marketplace{" "}
											<span aria-hidden="true">↗</span>
										</a>
									</li>
								))}
							</ul>
						</div>
					</div>
				</section>
			)
		}

		<section id="how" class="band" aria-labelledby="how-title">
			<div class="wrap">
				<div data-reveal>
					<p class="eyebrow">How it works</p>
					<h2 id="how-title">From request to pickup</h2>
				</div>
				<ol class="steps">
					{
						steps.map((step, i) => (
							<li data-reveal style={`--i: ${i}`}>
								<h3>{step.title}</h3>
								<p>{step.text}</p>
							</li>
						))
					}
				</ol>
				{
					site.intakeUrl && (
						<p class="next" data-reveal>
							<a class="button" href="/request/">Request a repair</a>
							<span>
								Questions first? <a href={site.messengerUrl}>Message us</a>.
							</span>
						</p>
					)
				}
			</div>
		</section>

		{
			renderedRepairs.length > 0 && (
				<section id="repairs" class="band" aria-labelledby="repairs-title">
					<div class="wrap">
						<p class="eyebrow">Past repairs</p>
						<h2 id="repairs-title">Before and after</h2>
						<ul class="cards">
							{renderedRepairs.map(({ data, Content }, i) => (
								<li class="card" data-reveal style={`--i: ${i}`}>
									<h3>{data.title}</h3>
									<p class="meta">
										{data.device} · <time datetime={data.date.toISOString()}>{monthFormat.format(data.date)}</time>
									</p>
									<div class="photos">
										<figure>
											<Image src={data.before} alt={data.beforeAlt} width={400} />
											<figcaption>Before</figcaption>
										</figure>
										<figure>
											<Image src={data.after} alt={data.afterAlt} width={400} />
											<figcaption>After</figcaption>
										</figure>
									</div>
									<Content />
								</li>
							))}
						</ul>
					</div>
				</section>
			)
		}

		<section id="contact" class="band" aria-labelledby="contact-title">
			<div class="wrap">
				<div class="contact" data-reveal>
					<div>
						<p class="eyebrow">Contact</p>
						<h2 id="contact-title">Tell us what's wrong</h2>
						<p>
							{
								site.intakeUrl ? (
									<>
										<a href="/request/">Send a repair request</a> and pick a drop-off time, or ask us
										anything first on <a href={site.messengerUrl}>Messenger</a> or at{" "}
										<a href={`mailto:${site.email}`}>{site.email}</a>.
									</>
								) : (
									<>
										<a href={site.messengerUrl}>Message us on Messenger</a> or email{" "}
										<a href={`mailto:${site.email}`}>{site.email}</a>.
									</>
								)
							}{" "}
							{
								site.marketplace && (
									<>
										See our listings and reviews on{" "}
										<a href={site.marketplace.url}>Facebook Marketplace</a>.
									</>
								)
							}
						</p>
						<div class="actions">
							{site.intakeUrl && <a class="button" href="/request/">Request a repair</a>}
							<a class={site.intakeUrl ? "button secondary" : "button"} href={site.messengerUrl}>
								Message us
							</a>
							<span class="email">
								<a class="button secondary" href={`mailto:${site.email}`}>Email us</a>
								<button class="button secondary copy" type="button" data-copy={site.email} aria-label="Copy email address" hidden>
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<g class="clip">
											<rect x="8" y="8" width="12" height="12" rx="2" />
											<path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" />
										</g>
										<path class="tick" d="M5 12.5l4.5 4.5L19 7.5" />
									</svg>
								</button>
							</span>
						</div>
						<p class="visually-hidden" data-copy-status aria-live="polite"></p>
					</div>
					{
						(site.serviceArea || site.hours) && (
							<dl class="details">
								{site.serviceArea && (
									<div>
										<dt>Where</dt>
										<dd>{site.serviceArea}</dd>
									</div>
								)}
								{site.hours && (
									<div>
										<dt>When</dt>
										<dd>{site.hours}</dd>
									</div>
								)}
							</dl>
						)
					}
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<script>
	// Price calculator on cards whose service is priced per item (the stick drift fix).
	const money = (n: number) => `$${n}`;
	document.querySelectorAll<HTMLElement>(".calc").forEach((calc) => {
		const price = Number(calc.dataset.price);
		const bulkPrice = Number(calc.dataset.bulkPrice);
		const bulkFrom = Number(calc.dataset.bulkFrom);
		const item = calc.dataset.item!;
		const output = calc.querySelector<HTMLOutputElement>("[data-count]")!;
		const total = calc.querySelector<HTMLElement>("[data-total]")!;
		const note = calc.querySelector<HTMLElement>("[data-note]")!;
		const minus = calc.querySelector<HTMLButtonElement>('[data-step="-1"]')!;
		const MAX = 12;
		let count = Number(output.value);

		const render = () => {
			const each = count >= bulkFrom ? bulkPrice : price;
			output.textContent = String(count);
			total.textContent = money(count * each);
			const more = bulkFrom - count;
			note.textContent =
				more > 0
					? ` · ${more} more ${more === 1 ? item : `${item}s`} and they're ${money(bulkPrice)} each`
					: ` · ${money(each)} each, you save ${money(count * (price - bulkPrice))}`;
			minus.disabled = count <= 1;
			total.classList.remove("bump");
			// Restart the animation on every change.
			void total.offsetWidth;
			total.classList.add("bump");
		};

		calc.addEventListener("click", (event) => {
			const step = (event.target as Element).closest<HTMLButtonElement>("[data-step]");
			if (!step) return;
			count = Math.min(MAX, Math.max(1, count + Number(step.dataset.step)));
			render();
		});
		calc.hidden = false;
		render();
	});

	// A pointer-following glow on cards.
	document.querySelectorAll<HTMLElement>(".card").forEach((card) => {
		card.addEventListener("pointermove", (event) => {
			const rect = card.getBoundingClientRect();
			card.style.setProperty("--x", `${event.clientX - rect.left}px`);
			card.style.setProperty("--y", `${event.clientY - rect.top}px`);
		});
	});

	// Copy-email, for desktops without a mail app.
	document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
		if (!navigator.clipboard) return;
		const status = button.closest(".contact")?.querySelector<HTMLElement>("[data-copy-status]");
		let timer = 0;
		button.hidden = false;
		button.addEventListener("click", async () => {
			try {
				await navigator.clipboard.writeText(button.dataset.copy!);
				button.classList.add("is-copied");
				if (status) status.textContent = `Copied ${button.dataset.copy} to the clipboard.`;
			} catch {
				if (status) status.textContent = "Couldn't copy the email address.";
			}
			clearTimeout(timer);
			timer = window.setTimeout(() => {
				button.classList.remove("is-copied");
				if (status) status.textContent = "";
			}, 2000);
		});
	});
</script>

<style>
	/* Hero */
	.hero {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		padding-block: clamp(3rem, 2rem + 5vw, 6rem);
	}
	.hero-grid {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
		align-items: center;
		gap: 3rem;
	}
	h1 {
		margin: 0;
	}
	/* The intro rises in on load, one line after another. */
	@media (prefers-reduced-motion: no-preference) {
		.intro > * {
			animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
		}
		.intro > :nth-child(2) {
			animation-delay: 0.08s;
		}
		.intro > :nth-child(3) {
			animation-delay: 0.16s;
		}
		.intro > :nth-child(4) {
			animation-delay: 0.24s;
		}
		.intro > :nth-child(5) {
			animation-delay: 0.32s;
		}
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(0.75rem);
		}
	}
	.lede {
		margin: 1.25rem 0 0;
		max-width: 32rem;
		font-size: 1.1875rem;
		color: var(--muted);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}
	.rating {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0.5rem;
		margin-top: 1.5rem;
		color: var(--muted);
		font-size: 0.9375rem;
		text-decoration: none;
	}
	.rating:hover {
		color: var(--accent);
	}
	.stars {
		color: var(--accent);
		letter-spacing: 0.1em;
	}
	.rating {
		flex-direction: column;
		align-items: flex-start;
	}
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.25rem 0.75rem 0.25rem 0.375rem;
		border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--line));
		border-radius: 999px;
		background: color-mix(in srgb, var(--accent) 8%, var(--surface));
		color: var(--ink);
		font-weight: 600;
		font-size: 0.875rem;
		transition:
			border-color 0.2s,
			background-color 0.2s,
			translate 0.2s;
	}
	.badge :global(svg) {
		width: 1.5rem;
		height: 1.5rem;
		flex: none;
	}
	/* On hover the badge firms up in the accent, its rosette pops out with a turn and the stars
	   spread out with a glow. Eased out with no overshoot, and held while hovered. */
	.rating:hover .badge,
	.rating:focus-visible .badge {
		border-color: var(--accent);
		background: color-mix(in srgb, var(--accent) 14%, var(--surface));
	}
	@media (prefers-reduced-motion: no-preference) {
		.rating .badge :global(svg) {
			transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
		}
		.rating:hover .badge :global(svg),
		.rating:focus-visible .badge :global(svg) {
			transform: rotate(1turn) scale(1.2);
		}
		.rating .stars {
			transition:
				letter-spacing 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
				filter 0.35s;
		}
		.rating:hover .stars,
		.rating:focus-visible .stars {
			letter-spacing: 0.2em;
			filter: drop-shadow(0 0 4px var(--accent));
		}
	}

	/* Reviews */
	.reviews {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
		gap: 1.5rem;
		align-items: start;
	}
	.summary {
		display: grid;
		gap: 1.25rem;
		padding: 1.5rem;
		border-radius: 0.75rem;
		background: var(--bg);
		border: 1px solid var(--line);
	}
	.summary > * {
		margin: 0;
	}
	.score {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.score > strong {
		font-family: var(--font-mono);
		font-size: 3rem;
		font-weight: 500;
		line-height: 1;
		color: var(--ink);
	}
	.score > span {
		display: grid;
		color: var(--muted);
		font-size: 0.9375rem;
	}
	.score .stars {
		font-size: 1.25rem;
	}
	.badge.big {
		gap: 0.75rem;
		padding: 0.625rem 1rem 0.625rem 0.625rem;
		border-radius: 0.75rem;
		font-weight: 400;
	}
	.badge.big :global(svg) {
		width: 2.25rem;
		height: 2.25rem;
	}
	.badge.big > span {
		display: grid;
		color: var(--muted);
	}
	.badge.big strong {
		color: var(--ink);
		font-size: 1rem;
	}
	.summary h3 {
		margin-bottom: -0.5rem;
		font-size: 0.9375rem;
	}
	.strengths {
		display: grid;
		gap: 0.75rem;
		padding: 0;
		list-style: none;
	}
	.strengths li {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.25rem;
		font-size: 0.9375rem;
	}
	.count {
		font-family: var(--font-mono);
		color: var(--muted);
	}
	.bar {
		grid-column: 1 / -1;
		height: 0.375rem;
		border-radius: 999px;
		background: var(--line);
		overflow: hidden;
	}
	.bar::before {
		content: "";
		display: block;
		height: 100%;
		border-radius: inherit;
		background: var(--accent);
		transform: scaleX(var(--share));
		transform-origin: left;
	}
	/* The bars fill in once the summary scrolls into view. */
	@media (prefers-reduced-motion: no-preference) {
