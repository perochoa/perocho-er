---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import HeroScene from "../components/HeroScene.astro";
import Joystick from "../components/Joystick.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const renderedServices = await Promise.all(
	services.map(async (service) => ({ ...service, Content: (await render(service)).Content })),
);

const repairs = (await getCollection("repairs")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const renderedRepairs = await Promise.all(
	repairs.map(async (repair) => ({ ...repair, Content: (await render(repair)).Content })),
);

const monthFormat = new Intl.DateTimeFormat("en-CA", { month: "long", year: "numeric" });

// Only facts the site already states elsewhere; nothing invented. The rating is in the hero.
const facts = [
	{ value: "~1 hr", label: "for most stick drift fixes" },
	{ value: "Drop-off", label: "or we come to you" },
	{ value: "Cash", label: "or Interac e-Transfer" },
];

const steps = [
	site.intakeUrl
		? { title: "Request a repair", text: "Fill in our form, or message us on Messenger or by email." }
		: { title: "Message us", text: "On Messenger or by email, about your device." },
	{ title: "Get a quote", text: "We reply with a price and agree on a time." },
	{ title: "Drop it off", text: "Or we come to you." },
	{ title: "Pay when it's done", text: "By cash or Interac e-Transfer." },
];
---

<BaseLayout title={site.name} description={site.description}>
	<main>
		<section class="hero">
			<HeroScene />
			<div class="wrap hero-grid">
				<div>
					<p class="eyebrow">Family-run · Mississauga</p>
					<h1>{site.tagline}</h1>
					<p class="lede">{site.intro}</p>
					<div class="actions">
						{
							site.intakeUrl ? (
								<>
									<a class="button" href="/request/">Request a repair</a>
									<a class="button secondary" href={site.messengerUrl}>Message us</a>
								</>
							) : (
								<>
									<a class="button" href={site.messengerUrl}>Message us</a>
									<a class="button secondary" href="#services">See prices</a>
								</>
							)
						}
					</div>
					{
						site.marketplace && (
							<a class="rating" href={site.marketplace.url}>
								<span class="stars" aria-hidden="true">{"★".repeat(site.marketplace.stars)}</span>
								{site.marketplace.stars} stars from {site.marketplace.ratings} ratings on Facebook
								Marketplace
							</a>
						)
					}
				</div>

				<Joystick requestHref={site.intakeUrl ? "/request/" : ""} />
			</div>
		</section>

		<section class="facts" aria-label="At a glance">
			<ul class="wrap fact-grid">
				{
					facts.map((fact) => (
						<li>
							<strong>{fact.value}</strong>
							<span>{fact.label}</span>
						</li>
					))
				}
			</ul>
		</section>

		<section id="services" class="band" aria-labelledby="services-title">
			<div class="wrap">
				<p class="eyebrow">Services</p>
				<h2 id="services-title">What we fix</h2>
				<ul class="cards">
					{
						renderedServices.map(({ data, Content }) => (
							<li class="card">
								<h3>{data.title}</h3>
								<div class="body">
									<Content />
								</div>
								<p class="price">{data.price ?? "Message us for a quote"}</p>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section id="how" class="band alt" aria-labelledby="how-title">
			<div class="wrap">
				<p class="eyebrow">How it works</p>
				<h2 id="how-title">Four simple steps</h2>
				<ol class="steps">
					{
						steps.map((step) => (
							<li>
								<h3>{step.title}</h3>
								<p>{step.text}</p>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		{
			renderedRepairs.length > 0 && (
				<section id="repairs" class="band" aria-labelledby="repairs-title">
					<div class="wrap">
						<p class="eyebrow">Past repairs</p>
						<h2 id="repairs-title">Before and after</h2>
						<ul class="cards">
							{renderedRepairs.map(({ data, Content }) => (
								<li class="card">
									<h3>{data.title}</h3>
									<p class="meta">
										{data.device} · <time datetime={data.date.toISOString()}>{monthFormat.format(data.date)}</time>
									</p>
									<div class="photos">
										<figure>
											<Image src={data.before} alt={data.beforeAlt} width={400} />
											<figcaption>Before</figcaption>
										</figure>
										<figure>
											<Image src={data.after} alt={data.afterAlt} width={400} />
											<figcaption>After</figcaption>
										</figure>
									</div>
									<Content />
								</li>
							))}
						</ul>
					</div>
				</section>
			)
		}

		<section id="contact" class="band" aria-labelledby="contact-title">
			<div class="wrap">
				<div class="contact">
					<div>
						<p class="eyebrow">Contact</p>
						<h2 id="contact-title">Tell us what's wrong</h2>
						<p>
							{site.intakeUrl && (
								<>
									<a href="/request/">Send us a repair request</a>,{" "}
								</>
							)}
							<a href={site.messengerUrl}>{site.intakeUrl ? "message" : "Message"} us on Messenger</a> or email{" "}
							<a href={`mailto:${site.email}`}>{site.email}</a>.{" "}
							{
								site.marketplace && (
									<>
										See our listings and reviews on{" "}
										<a href={site.marketplace.url}>Facebook Marketplace</a>.
									</>
								)
							}
						</p>
						<div class="actions">
							{site.intakeUrl && <a class="button" href="/request/">Request a repair</a>}
							<a class={site.intakeUrl ? "button secondary" : "button"} href={site.messengerUrl}>
								Message us
							</a>
							<a class="button secondary" href={`mailto:${site.email}`}>Email us</a>
						</div>
					</div>
					<div class="details">
						<h3>For a faster quote, tell us</h3>
						<ul class="checklist">
							<li>the device and its model</li>
							<li>what's wrong with it</li>
							<li>a photo, if you can</li>
						</ul>
						{
							(site.serviceArea || site.hours) && (
								<dl>
									{site.serviceArea && (
										<div>
											<dt>Service area</dt>
											<dd>{site.serviceArea}</dd>
										</div>
									)}
									{site.hours && (
										<div>
											<dt>Hours</dt>
											<dd>{site.hours}</dd>
										</div>
									)}
								</dl>
							)
						}
					</div>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	/* Hero */
	.hero {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		padding-block: clamp(3rem, 2rem + 5vw, 6rem);
	}
	.hero-grid {
		position: relative;
		z-index: 1;
	}
	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
		align-items: center;
		gap: 3rem;
	}
	h1 {
		margin: 0;
	}
	.lede {
		margin: 1.25rem 0 0;
		max-width: 32rem;
		font-size: 1.1875rem;
		color: var(--muted);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}
	.rating {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0.5rem;
		margin-top: 1.5rem;
		color: var(--muted);
		font-size: 0.9375rem;
		text-decoration: none;
	}
	.rating:hover {
		color: var(--accent);
	}
	.stars {
		color: var(--accent);
		letter-spacing: 0.1em;
	}

	/* Facts strip */
	.facts {
		background: var(--surface);
		border-block: 1px solid var(--line);
	}
	.fact-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin-block: 0;
		list-style: none;
	}
	.fact-grid li {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		padding: 1.25rem 1.25rem 1.25rem 0;
	}
	.fact-grid li + li {
		padding-left: 1.25rem;
		border-left: 1px solid var(--line);
	}
	.fact-grid strong {
		font-family: var(--font-mono);
		font-size: 1.375rem;
		font-weight: 500;
		color: var(--accent);
	}
	.fact-grid span {
		color: var(--muted);
		font-size: 0.9375rem;
	}

	/* Section bands */
	.band {
		padding-block: clamp(3rem, 2rem + 4vw, 5rem);
	}
	.band.alt {
		background: var(--surface);
		border-block: 1px solid var(--line);
	}
	.band h2 {
		margin: 0 0 2rem;
	}

	/* Cards */
	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.card {
		display: flex;
		flex-direction: column;
		padding: 1.5rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 0.75rem;
		transition: border-color 0.15s;
	}
	.card:hover {
		border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
	}
	.card h3 {
		margin: 0 0 0.75rem;
	}
	.card .body {
		flex: 1;
		color: var(--muted);
	}
	.card .body :global(strong) {
		color: var(--ink);
	}
	.card .body :global(ul) {
		padding-left: 1.125rem;
	}
	.card .body :global(li + li) {
		margin-top: 0.375rem;
	}
	.price {
		margin: 1.25rem 0 0;
		padding-top: 1rem;
		border-top: 1px solid var(--line);
		font-family: var(--font-mono);
		font-weight: 500;
		color: var(--accent);
	}

	/* Steps */
	.steps {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		counter-reset: step;
	}
	.steps li {
		position: relative;
		counter-increment: step;
		padding-top: 3.5rem;
	}
	.steps li::before {
		content: counter(step, decimal-leading-zero);
		position: absolute;
		top: 0;
		left: 0;
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		background: var(--accent);
		color: var(--on-accent);
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: 0.875rem;
	}
	/* Connector between step markers. */
	.steps li:not(:last-child)::after {
		content: "";
		position: absolute;
		top: 1.25rem;
		left: 3.25rem;
		right: -0.75rem;
		border-top: 2px dashed var(--line);
	}
	.steps h3 {
		margin: 0 0 0.375rem;
	}
	.steps p {
		margin: 0;
		color: var(--muted);
	}

	/* Repairs */
	.meta,
	figcaption {
		color: var(--muted);
	}
	.photos {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.5rem;
	}
	figure {
		margin: 0;
	}
	figure :global(img) {
		width: 100%;
		height: auto;
		border-radius: 0.375rem;
	}

	/* Contact */
	.contact {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
		gap: 2.5rem;
		padding: clamp(1.5rem, 1rem + 3vw, 3rem);
		border-radius: 1rem;
		background: color-mix(in srgb, var(--accent) 9%, var(--surface));
		border: 1px solid color-mix(in srgb, var(--accent) 25%, var(--line));
	}
	.contact h2 {
		margin-bottom: 1rem;
	}
	.contact .actions {
		margin-top: 1.5rem;
	}
	.details {
		padding: 1.5rem;
		border-radius: 0.75rem;
		background: var(--surface);
		border: 1px solid var(--line);
	}
	.details h3 {
		margin: 0 0 0.75rem;
	}
	.checklist {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.checklist li {
		position: relative;
		padding-left: 1.75rem;
	}
	.checklist li + li {
		margin-top: 0.375rem;
	}
	.checklist li::before {
		content: "";
		position: absolute;
		left: 0.25rem;
		top: 0.45em;
		width: 0.625rem;
		height: 0.625rem;
		border-radius: 50%;
		background: var(--accent);
	}
	dl {
		display: grid;
		gap: 0.75rem;
		margin: 1.25rem 0 0;
		padding-top: 1.25rem;
		border-top: 1px solid var(--line);
	}
	dt {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}
	dd {
		margin: 0.125rem 0 0;
	}

	@media (max-width: 56rem) {
		.steps {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			row-gap: 2rem;
		}
		.steps li:nth-child(2)::after {
			display: none;
		}
	}
	@media (max-width: 48rem) {
		.hero-grid,
		.contact {
			grid-template-columns: minmax(0, 1fr);
		}
		.hero-grid {
			gap: 2.5rem;
		}
	}
	@media (max-width: 30rem) {
		.steps {
			grid-template-columns: minmax(0, 1fr);
		}
		.steps li::after {
			display: none;
		}
		.fact-grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.fact-grid li + li {
			padding-left: 0;
			border-left: 0;
			border-top: 1px solid var(--line);
		}
		.actions .button {
			flex: 1;
		}
	}
</style>
