---
import { getCollection } from "astro:content";
import Contact from "../components/Contact.astro";
import Facts from "../components/Facts.astro";
import Hero from "../components/Hero.astro";
import Repairs from "../components/Repairs.astro";
import Reviews from "../components/Reviews.astro";
import Services from "../components/Services.astro";
import Steps from "../components/Steps.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const repairs = (await getCollection("repairs")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title={site.name} description={site.description}>
	<main>
		<Hero />
		<Facts />
		<Services services={services} />
		<Reviews />
		<Steps />
		<Repairs repairs={repairs} />
		<Contact />
	</main>
</BaseLayout>

<script>
	// A pointer-following glow on the sections' cards.
	document.querySelectorAll<HTMLElement>(".card").forEach((card) => {
		card.addEventListener("pointermove", (event) => {
			const rect = card.getBoundingClientRect();
			card.style.setProperty("--x", `${event.clientX - rect.left}px`);
			card.style.setProperty("--y", `${event.clientY - rect.top}px`);
		});
	});
</script>

<style is:global>
	/* Classes the sections share. Global, but only on this page: the request form has its own .card. */
	.stars {
		color: var(--accent);
		letter-spacing: 0.1em;
	}
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.25rem 0.75rem 0.25rem 0.375rem;
		border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--line));
		border-radius: 999px;
		background: color-mix(in srgb, var(--accent) 8%, var(--surface));
		color: var(--ink);
		font-weight: 600;
		font-size: 0.875rem;
		transition:
			border-color 0.2s,
			background-color 0.2s,
			translate 0.2s;
	}
	.badge svg {
		width: 1.5rem;
		height: 1.5rem;
		flex: none;
	}

	/* Section bands */
	.band {
		padding-block: clamp(3rem, 2rem + 4vw, 5rem);
	}
	.band.alt {
		background: var(--surface);
		border-block: 1px solid var(--line);
	}
	.band h2 {
		margin: 0 0 2rem;
	}

	/* Cards */
	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: 1.5rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 0.75rem;
		transition:
			border-color 0.15s,
			box-shadow 0.25s,
			translate 0.25s;
	}
	/* A soft glow that follows the pointer (--x, --y are set by the script). */
	.card::before {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: radial-gradient(
			18rem circle at var(--x, 50%) var(--y, 0%),
			color-mix(in srgb, var(--accent) 9%, transparent),
			transparent 70%
		);
		opacity: 0;
		transition: opacity 0.25s;
		pointer-events: none;
	}
	.card > * {
		position: relative;
	}
	.card:hover {
		border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
		box-shadow: 0 14px 32px -20px color-mix(in srgb, var(--accent) 60%, transparent);
	}
	.card:hover::before {
		opacity: 1;
	}
	@media (prefers-reduced-motion: no-preference) {
		.card:hover {
			translate: 0 -3px;
		}
	}
	.card h3 {
		margin: 0 0 0.75rem;
	}
	.ask {
		align-self: flex-start;
		margin-top: 0.75rem;
		font-weight: 600;
		font-size: 0.9375rem;
		text-decoration: none;
	}
	.ask span {
		display: inline-block;
		transition: transform 0.2s;
	}
	.ask:hover span,
	.ask:focus-visible span {
		transform: translateX(4px);
	}
</style>
