---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../site";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={`Request a repair · ${site.name}`} description={`Request a repair from ${site.name}.`}>
	<main class="wrap">
		<p class="eyebrow">Request a repair</p>
		<h1>Tell us about your device</h1>
		<p class="lede">
			Pick a time to drop your device off, and a tech will call or email you about the price. Nothing is
			booked until a tech confirms.{" "}
			Prefer Facebook? <a href={site.messengerUrl}>Message us on Messenger</a>
			{
				site.marketplace && (
					<>
						{" "}or find us on <a href={site.marketplace.url}>Marketplace</a>
					</>
				)
			}.
		</p>

		{
			site.intakeUrl ? (
				<form method="post" action={`${site.intakeUrl}/request`} data-slots={`${site.intakeUrl}/slots`}>
					<p class="hint">Every field is required unless it says optional.</p>

					<!-- Without a time the worker turns the request down, so without JS (no time list) or
					     without open times, point people to the other ways in. -->
					<noscript>
						<p class="notice">
							Picking a drop-off time needs JavaScript. <a href={site.messengerUrl}>Message us on Messenger</a> or
							email <a href={`mailto:${site.email}`}>{site.email}</a>, and we'll find a time.
						</p>
					</noscript>
					<p class="notice" data-no-slots tabindex="-1" hidden>
						<span data-no-slots-reason></span> <a href={site.messengerUrl}>Message us on Messenger</a> or email{" "}
						<a href={`mailto:${site.email}`}>{site.email}</a>, and we'll find a time.
					</p>

					<div class="card">
						<fieldset>
							<legend>You</legend>
							<label>
								Name
								<input name="name" autocomplete="name" maxlength="100" required />
							</label>
							<label>
								Email
								<input type="email" name="email" autocomplete="email" maxlength="200" required aria-describedby="email-hint" />
							</label>
							<p class="hint" id="email-hint">We'll email you when we get your request, and again when a tech confirms it.</p>
							<label>
								Phone
								<input type="tel" name="phone" autocomplete="tel" inputmode="tel" maxlength="30" required aria-describedby="phone-hint" />
							</label>
							<p class="hint" id="phone-hint">With the area code, so a tech can call you about the price.</p>
						</fieldset>
					</div>

					<div class="card">
						<fieldset>
							<legend>The repair</legend>
							<label>
								Service
								<select name="service">
									{services.map((service) => <option>{service.data.title}</option>)}
									<option value="">Something else, or not sure</option>
								</select>
							</label>
							<label>
								Device and model
								<input name="device" maxlength="150" placeholder="e.g. DualSense controller, PS5 Slim" required />
							</label>
							<label>
								What's wrong?
								<textarea name="problem" rows="4" maxlength="2000" required></textarea>
							</label>
						</fieldset>
					</div>

					<div class="card">
						<fieldset>
							<legend>Drop-off time</legend>
							<p class="hint">When you'll bring your device in. Only times when a tech is free are shown.</p>
							<div class="slots" data-slot-field role="group" aria-labelledby="slot-label" aria-describedby="slot-error" hidden>
								<span id="slot-label">Pick a day, then a time</span>
								<div class="week">
									<button class="step" type="button" data-prev aria-label="Previous week">‹</button>
									<span data-week-label aria-live="polite"></span>
									<button class="step" type="button" data-next aria-label="Next week">›</button>
								</div>
								<div class="days" data-days></div>
								<p class="hint" data-day-note></p>
								<div data-times></div>
							</div>
							<div class="status" aria-live="polite">
								<p class="hint" data-slot-note></p>
								<p class="error" id="slot-error" data-slot-error></p>
							</div>
						</fieldset>
					</div>

					<div class="card">
						<label>
							<span>Anything else? <span class="optional">(optional)</span></span>
							<textarea name="notes" rows="3" maxlength="2000" aria-describedby="notes-hint"></textarea>
						</label>
						<p class="hint" id="notes-hint">What you've tried, or anything you're bringing with it.</p>
					</div>

					<!-- Hidden from people; bots fill it in. -->
					<div class="trap" aria-hidden="true">
						<label>
							Leave this empty
							<input name="website" tabindex="-1" autocomplete="off" />
						</label>
					</div>

					<!-- Shown once there are times to pick. -->
					<button class="button" type="submit" hidden>Send request</button>
				</form>
			) : (
				<p>
					<a class="button" href={site.messengerUrl}>Message us</a>
				</p>
			)
		}
	</main>
</BaseLayout>

<script>
	const form = document.querySelector<HTMLFormElement>("form[data-slots]");

	if (form) {
		const send = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
		const field = form.querySelector<HTMLElement>("[data-slot-field]")!;
		const days = field.querySelector<HTMLElement>("[data-days]")!;
		const times = field.querySelector<HTMLElement>("[data-times]")!;
		const weekLabel = field.querySelector<HTMLElement>("[data-week-label]")!;
		const prev = field.querySelector<HTMLButtonElement>("[data-prev]")!;
		const next = field.querySelector<HTMLButtonElement>("[data-next]")!;
		const dayNote = field.querySelector<HTMLElement>("[data-day-note]")!;
		const note = form.querySelector<HTMLElement>("[data-slot-note]")!;
		const error = form.querySelector<HTMLElement>("[data-slot-error]")!;
		const noSlots = form.querySelector<HTMLElement>("[data-no-slots]")!;
		const noSlotsReason = noSlots.querySelector<HTMLElement>("[data-no-slots-reason]")!;
		note.textContent = "Loading open times…";

		// A request needs a time, so with none to pick there's nothing to send: say so at the top of
		// the form, before they fill it in, and point them to Messenger and email.
		const unavailable = (reason: string) => {
			field.hidden = true;
			send.hidden = true;
			noSlots.hidden = false;
			noSlotsReason.textContent = reason;
			note.textContent = reason;
		};

		// Loose like the worker's check: separators and a leading + are fine, as long as there are 10
		// to 15 digits.
		const phone = form.querySelector<HTMLInputElement>("[name=phone]")!;
		phone.addEventListener("input", () => {
			const digits = phone.value.replace(/\D/g, "").length;
			const valid = phone.value === "" || (/^\s*\+?[\d\s().-]+$/.test(phone.value) && digits >= 10 && digits <= 15);
			phone.setCustomValidity(valid ? "" : "Enter your phone number with its area code, like 416-555-0123.");
		});

		// Dates are plain calendar days: noon UTC, so adding days and formatting never shifts them.
		const noon = (date: string) => new Date(`${date}T12:00:00Z`);
		const addDays = (date: string, n: number) => new Date(noon(date).getTime() + n * 864e5).toISOString().slice(0, 10);
		const sundayOf = (date: string) => addDays(date, -noon(date).getUTCDay());
		const day = new Intl.DateTimeFormat("en-CA", { timeZone: "UTC", weekday: "long", month: "long", day: "numeric" });
		const weekday = new Intl.DateTimeFormat("en-CA", { timeZone: "UTC", weekday: "short" });
		const dayOfMonth = new Intl.DateTimeFormat("en-CA", { timeZone: "UTC", day: "numeric" });
		const range = new Intl.DateTimeFormat("en-CA", { timeZone: "UTC", month: "short", day: "numeric" });

		// Set from each /slots response.
		let dateOf = (start: Date) => start.toISOString().slice(0, 10);
		let groups = new Map<string, HTMLElement>();
		let weeks: string[] = [];
		let week = 0;
		let picked = "";

		const chosen = () => form.querySelector<HTMLInputElement>("[name=slot]:checked");

		// Seven day buttons at a time. The first week starts today, so it shows a full seven days; the
		// arrows step through the Sunday-to-Saturday weeks after it that have times.
		const inWeek = (date: string, start: string) => date >= start && date <= addDays(start, 6);
		const buttons = Array.from({ length: 7 }, () => {
			const button = Object.assign(document.createElement("button"), { type: "button", className: "day" });
			button.addEventListener("click", () => {
				picked = button.dataset.date!;
				render();
			});
			days.append(button);
			return button;
		});
		const render = () => {
			const start = weeks[week];
			weekLabel.textContent = range.formatRange(noon(start), noon(addDays(start, 6)));
			prev.disabled = week === 0;
			next.disabled = week === weeks.length - 1;
			buttons.forEach((button, i) => {
				const date = addDays(start, i);
				button.dataset.date = date;
				button.disabled = !groups.has(date);
				button.setAttribute("aria-pressed", String(date === picked));
				button.setAttribute("aria-label", day.format(noon(date)) + (button.disabled ? ": no techs available" : ""));
				button.replaceChildren(Object.assign(document.createElement("span"), { textContent: weekday.format(noon(date)) }), dayOfMonth.format(noon(date)));
			});
			groups.forEach((group, date) => (group.hidden = date !== picked));
			dayNote.textContent = [
				picked ? "" : "Pick a day to see its times.",
				buttons.some((button) => button.disabled) ? "Greyed-out days have no techs available." : "",
			].join(" ").trim();
			dayNote.hidden = !dayNote.textContent;
		};
		const step = (by: number) => {
			week += by;
			// A picked time stays picked; its day opens again when its week comes back.
			const slot = chosen()?.value;
			const date = slot && dateOf(new Date(slot));
			picked = date && inWeek(date, weeks[week]) ? date : "";
			render();
		};
		prev.addEventListener("click", () => step(-1));
		next.addEventListener("click", () => step(1));

		// Ends a sentence on a time without doubling the period of "a.m." and "p.m.".
		const stop = (text: string) => (text.endsWith(".") ? text : `${text}.`);
		const describe = (radio: HTMLInputElement | null) => (radio ? `${stop(radio.dataset.label!)} We'll hold it for you until a tech confirms.` : "");
		field.addEventListener("change", (event) => {
			const radio = event.target as HTMLInputElement;
			if (radio.name !== "slot") return;
			note.textContent = describe(radio);
			error.textContent = "";
		});

		// Builds the picker from a /slots response. Called again whenever the times change, so it keeps
		// their pick, the day they had open and the week they were on wherever those still exist.
		const show = ({ timeZone, slots }: { timeZone: string; slots: { start: string; end: string }[] }) => {
			const before = chosen()?.value ?? "";
			const focused = document.activeElement instanceof HTMLInputElement && document.activeElement.name === "slot" ? document.activeElement.value : null;
			const shownWeek = weeks[week];

			// Each slot's calendar date in the worker's zone, so the days match the times it offers and holds.
			const parts = new Intl.DateTimeFormat("en-CA", { timeZone, year: "numeric", month: "2-digit", day: "2-digit" });
			dateOf = (start: Date) => {
				const part = Object.fromEntries(parts.formatToParts(start).map(({ type, value }) => [type, value]));
				return `${part.year}-${part.month}-${part.day}`;
			};
			const time = new Intl.DateTimeFormat("en-CA", { timeZone, hour: "numeric", minute: "2-digit" });

			// Each day's times are a group of radios, shown only while that day is picked.
			groups = new Map();
			times.replaceChildren();
			for (const slot of slots) {
				const start = new Date(slot.start);
				const date = dateOf(start);
				let group = groups.get(date);
				if (!group) {
					group = Object.assign(document.createElement("div"), { className: "times", hidden: true });
					group.setAttribute("role", "radiogroup");
					group.setAttribute("aria-label", day.format(noon(date)));
					groups.set(date, group);
					times.append(group);
				}
				const radio = Object.assign(document.createElement("input"), { type: "radio", name: "slot", value: slot.start, checked: slot.start === before });
				radio.dataset.label = `${day.format(noon(date))}, ${time.format(start)} to ${time.format(new Date(slot.end))}`;
				const chip = Object.assign(document.createElement("label"), { className: "chip" });
				chip.append(radio, time.format(start));
				group.append(chip);
			}

			const lost = before !== "" && !chosen();
			if (focused !== null) form.querySelector<HTMLInputElement>(`[name=slot][value="${focused}"]`)?.focus();
			if (lost) error.textContent = "The time you picked was just taken. Pick another.";

			if (slots.length === 0) {
				weeks = [];
				unavailable("There are no open times online right now.");
				return;
			}
			// This week starts today instead of on Sunday.
			const today = dateOf(new Date());
			weeks = [...new Set([...groups.keys()].map((date) => (sundayOf(date) < today ? today : sundayOf(date))))].sort();
			week = Math.max(0, weeks.indexOf(shownWeek));
			if (!groups.has(picked) || !inWeek(picked, weeks[week])) picked = "";
			render();
			field.hidden = false;
			send.hidden = false;
			noSlots.hidden = true;
			note.textContent = describe(chosen());
		};

		// Without a picked time the worker turns the request down, so stop here and take them to the
		// picker. The browser has already checked the other fields by now.
		form.addEventListener("submit", (event) => {
			if (chosen()) {
				// One request per press: a second one would come back "taken", beaten by the first.
				send.disabled = true;
				return;
			}
			event.preventDefault();
			if (weeks.length === 0) {
				noSlots.focus();
				return;
			}
			error.textContent = "Pick a drop-off time before you send your request.";
			const target = picked ? groups.get(picked)!.querySelector("input") : buttons.find((button) => !button.disabled);
			(target ?? next).focus();
		});
		// The back button brings the page back as it was left, so turn the button on again then.
		window.addEventListener("pageshow", () => (send.disabled = false));

		// Techs change their calendars while people fill in the form, so fetch again every so often
		// while the page is in view, and as soon as they come back to it. The picker is only rebuilt
		// when the times differ, so a refresh doesn't disturb someone using it.
		const REFRESH_MS = 60_000;
		let last = "";
		let fetchedAt = 0;
		let loading = false;
		const load = () => {
			if (loading) return;
			loading = true;
			fetchedAt = Date.now();
			fetch(form.dataset.slots!)
				.then((response) => (response.ok ? response.text() : Promise.reject(response.status)))
				.then((body) => {
					if (body === last) return;
					last = body;
					show(JSON.parse(body));
				})
				// Keep whatever is showing, and the next refresh tries again. With nothing showing yet,
				// say so instead of leaving them waiting.
				.catch(() => {
					if (last === "") unavailable("We couldn't load the open times.");
				})
				.finally(() => (loading = false));
		};
		load();
		setInterval(() => document.visibilityState === "visible" && load(), REFRESH_MS);
		document.addEventListener("visibilitychange", () => {
			if (document.visibilityState === "visible" && Date.now() - fetchedAt > REFRESH_MS / 4) load();
		});
	}
</script>

<style>
	main {
		max-width: 44rem;
		padding-block: clamp(3rem, 2rem + 4vw, 5rem);
	}
	h1 {
		margin: 0;
	}
	.lede {
		margin: 1rem 0 2rem;
		color: var(--muted);
	}
	form {
		--error: #b42318;
		display: grid;
		gap: 1.25rem;
	}
	@media (prefers-color-scheme: dark) {
		form {
			--error: #fda29b;
		}
	}
	/* The card is a wrapper, not the fieldset: Safari draws a fieldset's legend on its border. */
	.card {
		padding: 1.5rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 0.75rem;
	}
	fieldset {
		display: grid;
		gap: 1rem;
		min-width: 0;
		margin: 0;
		padding: 0;
		border: 0;
	}
	legend {
		margin-bottom: 1rem;
		padding: 0;
		font-size: 1.125rem;
		font-weight: 700;
	}
	label,
	.slots > span {
		display: grid;
		gap: 0.375rem;
		font-weight: 600;
		font-size: 0.9375rem;
	}
	.slots {
		display: grid;
		gap: 0.75rem;
		min-width: 0;
	}
	.week {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-weight: 600;
	}
	.days {
		display: grid;
		grid-template-columns: repeat(7, minmax(0, 1fr));
		gap: 0.375rem;
	}
	.step,
	.slots :global(.day),
	.slots :global(.chip) {
		border: 1px solid var(--line);
		border-radius: 0.5rem;
		background: var(--bg);
		color: var(--ink);
		font: inherit;
		cursor: pointer;
	}
	.step {
		width: 2.75rem;
		height: 2.75rem;
		font-size: 1.25rem;
		line-height: 1;
	}
	.slots :global(.day) {
		display: grid;
		justify-items: center;
		padding: 0.5rem 0;
		font-size: 0.9375rem;
	}
	.step:disabled,
	.slots :global(.day:disabled) {
		opacity: 0.4;
		cursor: default;
	}
	.slots :global(.day span) {
		color: var(--muted);
		font-size: 0.8125rem;
	}
	.step:hover:not(:disabled),
	.slots :global(.day:hover:not(:disabled)),
	.slots :global(.chip:hover) {
		border-color: var(--accent);
	}
	.slots :global(.day[aria-pressed="true"]),
	.slots :global(.chip:has(:checked)) {
		border-color: var(--accent);
		background: var(--accent);
		color: var(--on-accent);
	}
	.slots :global(.day[aria-pressed="true"] span) {
		color: inherit;
	}
	.slots :global(.times) {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr));
		gap: 0.5rem;
	}
	.slots :global(.chip) {
		display: block;
		position: relative;
		padding: 0.625rem 0.5rem;
		text-align: center;
		font-weight: 400;
	}
	.slots :global(.chip input) {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}
	.slots :global(.chip:has(:focus-visible)) {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.slots[hidden],
	.slots :global([hidden]) {
		display: none;
	}
	input:not([type="radio"]),
	select,
	textarea {
		box-sizing: border-box;
		width: 100%;
		padding: 0.625rem 0.75rem;
		border: 1px solid var(--line);
		border-radius: 0.5rem;
		background: var(--bg);
		color: var(--ink);
		font: inherit;
		font-weight: 400;
	}
	input:focus-visible,
	select:focus-visible,
	textarea:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 0;
		border-color: var(--accent);
	}
	textarea {
		resize: vertical;
	}
	.hint,
	.optional {
		margin: 0;
		color: var(--muted);
		font-size: 0.875rem;
		font-weight: 400;
	}
	/* A field's hint sits closer to it than to the next field: inside the fieldset's grid gap, and
	   under the notes field, which has no fieldset. */
	label + .hint {
		margin-top: -0.625rem;
	}
	.card > label + .hint {
		margin-top: 0.375rem;
	}
	.status {
		display: grid;
		gap: 0.5rem;
	}
	.status p:empty {
		display: none;
	}
	.error {
		margin: 0;
		color: var(--error);
		font-size: 0.9375rem;
		font-weight: 600;
	}
	.notice {
		margin: 0;
		padding: 1rem 1.25rem;
		border: 1px solid var(--accent);
		border-radius: 0.75rem;
		background: var(--surface);
	}
	.notice:focus {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.notice[hidden],
	button[hidden] {
		display: none;
	}
	.trap {
		position: absolute;
		left: -100vw;
	}
	button {
		justify-self: start;
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	@media (max-width: 40rem) {
		button {
			justify-self: stretch;
		}
	}
</style>
