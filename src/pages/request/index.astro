---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../site";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={`Request a repair · ${site.name}`} description={`Request a repair from ${site.name}.`}>
	<main class="wrap">
		<p class="eyebrow">Request a repair</p>
		<h1>Tell us about your device</h1>
		<p class="lede">
			Pick a time to drop your device off, and a tech will call or email you about the price and when it'll
			be ready. Nothing is booked until a tech confirms.{" "}
			Prefer Facebook? <a href={site.messengerUrl}>Message us on Messenger</a>
			{
				site.marketplace && (
					<>
						{" "}or find us on <a href={site.marketplace.url}>Marketplace</a>
					</>
				)
			}.
		</p>

		{
			site.intakeUrl ? (
				<form method="post" action={`${site.intakeUrl}/request`} data-slots={`${site.intakeUrl}/slots`}>
					<p class="hint">Every field is required unless it says optional.</p>

					<!-- Without a time the worker turns the request down, so without JS (no time list) or
					     without open times, point people to the other ways in. -->
					<noscript>
						<p class="notice">
							Picking a drop-off time needs JavaScript. <a href={site.messengerUrl}>Message us on Messenger</a> or
							email <a href={`mailto:${site.email}`}>{site.email}</a>, and we'll find a time.
						</p>
					</noscript>
					<p class="notice" data-no-slots tabindex="-1" hidden>
						<span data-no-slots-reason></span> <a href={site.messengerUrl}>Message us on Messenger</a> or email{" "}
						<a href={`mailto:${site.email}`}>{site.email}</a>, and we'll find a time.
					</p>

					<div class="card">
						<fieldset>
							<legend>You</legend>
							<label>
								Name
								<input name="name" autocomplete="name" maxlength="100" required />
							</label>
							<label>
								Email
								<input type="email" name="email" autocomplete="email" maxlength="200" required aria-describedby="email-hint" />
							</label>
							<p class="hint" id="email-hint">We'll email you when we get your request, and again when a tech confirms it.</p>
							<label>
								Phone
								<input type="tel" name="phone" autocomplete="tel" inputmode="tel" maxlength="30" required aria-describedby="phone-hint" />
							</label>
							<p class="hint" id="phone-hint">With the area code, so a tech can call you about the price.</p>
						</fieldset>
					</div>

					<div class="card">
						<fieldset>
							<legend>The repair</legend>
							<label>
								Service
								<select name="service">
									{services.map((service) => <option>{service.data.title}</option>)}
									<option value="">Something else, or not sure</option>
								</select>
							</label>
							<label>
								Device and model
								<input name="device" maxlength="150" placeholder="e.g. DualSense controller, PS5 Slim" required />
							</label>
							<label>
								What's wrong?
								<textarea name="problem" rows="4" maxlength="2000" required></textarea>
							</label>
							<label class="check">
								<input type="checkbox" name="rush" value="1" aria-describedby="rush-hint" />
								Rush it (+${site.rushFee})
							</label>
							<p class="hint" id="rush-hint">Rush repairs go to the front of the queue. You pay for it in person, with the repair.</p>
						</fieldset>
					</div>

					<div class="card">
						<fieldset>
							<legend>Drop-off time</legend>
							<p class="hint">When you'll bring your device in. Only times when a tech can take it in are shown.</p>
							<!-- The day has no name: it only narrows the times, and the time's value says the day. -->
							<div class="slots" data-slot-field hidden>
								<label>
									Day
									<select data-days></select>
								</label>
								<label>
									Time
									<select name="slot" data-times aria-describedby="slot-error"></select>
								</label>
							</div>
							<div class="status" aria-live="polite">
								<p class="hint" data-slot-note></p>
								<p class="error" id="slot-error" data-slot-error></p>
							</div>
						</fieldset>
					</div>

					<div class="card">
						<label>
							<span>Anything else? <span class="optional">(optional)</span></span>
							<textarea name="notes" rows="3" maxlength="2000" aria-describedby="notes-hint"></textarea>
						</label>
						<p class="hint" id="notes-hint">What you've tried, or anything you're bringing with it.</p>
					</div>

					<!-- Hidden from people; bots fill it in. -->
					<div class="trap" aria-hidden="true">
						<label>
							Leave this empty
							<input name="website" tabindex="-1" autocomplete="off" />
						</label>
					</div>

					<!-- Shown once there are times to pick. -->
					<button class="button" type="submit" hidden>Send request</button>
				</form>
			) : (
				<p>
					<a class="button" href={site.messengerUrl}>Message us</a>
				</p>
			)
		}
	</main>
</BaseLayout>

<script>
	const form = document.querySelector<HTMLFormElement>("form[data-slots]");

	if (form) {
		const send = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
		const field = form.querySelector<HTMLElement>("[data-slot-field]")!;
		const days = field.querySelector<HTMLSelectElement>("[data-days]")!;
		const times = field.querySelector<HTMLSelectElement>("[data-times]")!;
		const note = form.querySelector<HTMLElement>("[data-slot-note]")!;
		const error = form.querySelector<HTMLElement>("[data-slot-error]")!;
		const noSlots = form.querySelector<HTMLElement>("[data-no-slots]")!;
		const noSlotsReason = noSlots.querySelector<HTMLElement>("[data-no-slots-reason]")!;
		note.textContent = "Loading open times…";

		// A request needs a time, so with none to pick there's nothing to send: say so at the top of
		// the form, before they fill it in, and point them to Messenger and email.
		const unavailable = (reason: string) => {
			field.hidden = true;
			send.hidden = true;
			noSlots.hidden = false;
			noSlotsReason.textContent = reason;
			note.textContent = reason;
		};

		// Loose like the worker's check: separators and a leading + are fine, as long as there are 10
		// to 15 digits.
		const phone = form.querySelector<HTMLInputElement>("[name=phone]")!;
		phone.addEventListener("input", () => {
			const digits = phone.value.replace(/\D/g, "").length;
			const valid = phone.value === "" || (/^\s*\+?[\d\s().-]+$/.test(phone.value) && digits >= 10 && digits <= 15);
			phone.setCustomValidity(valid ? "" : "Enter your phone number with its area code, like 416-555-0123.");
		});

		// Dates are plain calendar days: noon UTC, so formatting never shifts them.
		const day = new Intl.DateTimeFormat("en-CA", { timeZone: "UTC", weekday: "short", month: "short", day: "numeric" });
		const dayOf = (date: string) => day.format(new Date(`${date}T12:00:00Z`));

		// Each day's times, by date; the time list only shows the picked day's.
		let byDay = new Map<string, { value: string; label: string }[]>();

		const option = (value: string, label: string) => Object.assign(document.createElement("option"), { value, textContent: label });
		const fill = (keep: string) => {
			times.replaceChildren(option("", "Pick a time"), ...(byDay.get(days.value) ?? []).map(({ value, label }) => option(value, label)));
			times.value = keep;
			if (times.value !== keep) times.value = "";
		};

		days.addEventListener("change", () => fill(""));
		times.addEventListener("change", () => (error.textContent = ""));

		// Builds the picker from a /slots response. Called again whenever the times change, so it keeps
		// their pick and the day they had open.
		const show = ({ timeZone, slots }: { timeZone: string; slots: { start: string }[] }) => {
			const before = times.value;
			const open = days.value;

			// Each slot's calendar date in the worker's zone, so the days match the times it offers and
			// holds.
			const date = new Intl.DateTimeFormat("en-CA", { timeZone, year: "numeric", month: "2-digit", day: "2-digit" });
			const time = new Intl.DateTimeFormat("en-CA", { timeZone, hour: "numeric", minute: "2-digit" });

			byDay = new Map();
			let dayOfBefore = "";
			for (const slot of slots) {
				const start = new Date(slot.start);
				const key = date.format(start);
				if (!byDay.has(key)) byDay.set(key, []);
				byDay.get(key)!.push({ value: slot.start, label: time.format(start) });
				if (slot.start === before) dayOfBefore = key;
			}

			if (before !== "" && dayOfBefore === "") error.textContent = "The time you picked isn't open any more. Pick another.";

			if (slots.length === 0) {
				unavailable("There are no open times online right now.");
				return;
			}
			// The day of their pick, else the day they had open, else the first one with times.
			days.replaceChildren(...[...byDay.keys()].map((key) => option(key, dayOf(key))));
			days.value = dayOfBefore || (byDay.has(open) ? open : byDay.keys().next().value!);
			fill(before);
			field.hidden = false;
			send.hidden = false;
			noSlots.hidden = true;
			note.textContent = "";
		};

		// Without a picked time the worker turns the request down, so stop here and take them to the
		// picker. The browser has already checked the other fields by now.
		form.addEventListener("submit", (event) => {
			if (times.value) {
				// One request per press; the worker would only file a second one as the same request.
				send.disabled = true;
				return;
			}
			event.preventDefault();
			if (byDay.size === 0) {
				noSlots.focus();
				return;
			}
			error.textContent = "Pick a drop-off time before you send your request.";
			times.focus();
		});
		// The back button brings the page back as it was left, so turn the button on again then.
		window.addEventListener("pageshow", () => (send.disabled = false));

		// Techs change their calendars while people fill in the form, so fetch again every so often
		// while the page is in view, and as soon as they come back to it. The picker is only rebuilt
		// when the times differ, so a refresh doesn't disturb someone using it.
		const REFRESH_MS = 60_000;
		let last = "";
		let fetchedAt = 0;
		let loading = false;
		const load = () => {
			if (loading) return;
			loading = true;
			fetchedAt = Date.now();
			fetch(form.dataset.slots!)
				.then((response) => (response.ok ? response.text() : Promise.reject(response.status)))
				.then((body) => {
					if (body === last) return;
					last = body;
					show(JSON.parse(body));
				})
				// Keep whatever is showing, and the next refresh tries again. With nothing showing yet,
				// say so instead of leaving them waiting.
				.catch(() => {
					if (last === "") unavailable("We couldn't load the open times.");
				})
				.finally(() => (loading = false));
		};
		load();
		setInterval(() => document.visibilityState === "visible" && load(), REFRESH_MS);
		document.addEventListener("visibilitychange", () => {
			if (document.visibilityState === "visible" && Date.now() - fetchedAt > REFRESH_MS / 4) load();
		});
	}
</script>

<style>
	main {
		max-width: 44rem;
		padding-block: clamp(3rem, 2rem + 4vw, 5rem);
	}
	h1 {
		margin: 0;
	}
	.lede {
		margin: 1rem 0 2rem;
		color: var(--muted);
	}
	form {
		--error: #b42318;
		display: grid;
		gap: 1.25rem;
	}
	@media (prefers-color-scheme: dark) {
		form {
			--error: #fda29b;
		}
	}
	/* The card is a wrapper, not the fieldset: Safari draws a fieldset's legend on its border. */
	.card {
		padding: 1.5rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 0.75rem;
	}
	fieldset {
		display: grid;
		gap: 1rem;
		min-width: 0;
		margin: 0;
		padding: 0;
		border: 0;
	}
	legend {
		margin-bottom: 1rem;
		padding: 0;
		font-size: 1.125rem;
		font-weight: 700;
	}
	label {
		display: grid;
		gap: 0.375rem;
		font-weight: 600;
		font-size: 0.9375rem;
	}
	.slots {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}
	.slots[hidden] {
		display: none;
	}
	.check {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		cursor: pointer;
	}
	.check input {
		flex: none;
		width: 1.25rem;
		height: 1.25rem;
		margin: 0;
		accent-color: var(--accent);
	}
	input:not([type="checkbox"]),
	select,
	textarea {
		box-sizing: border-box;
		width: 100%;
		padding: 0.625rem 0.75rem;
		border: 1px solid var(--line);
		border-radius: 0.5rem;
		background: var(--bg);
		color: var(--ink);
		font: inherit;
		font-weight: 400;
	}
	input:focus-visible,
	select:focus-visible,
	textarea:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 0;
		border-color: var(--accent);
	}
	textarea {
		resize: vertical;
	}
	.hint,
	.optional {
		margin: 0;
		color: var(--muted);
		font-size: 0.875rem;
		font-weight: 400;
	}
	/* A field's hint sits closer to it than to the next field: inside the fieldset's grid gap, and
	   under the notes field, which has no fieldset. */
	label + .hint {
		margin-top: -0.625rem;
	}
	.card > label + .hint {
		margin-top: 0.375rem;
	}
	.status {
		display: grid;
		gap: 0.5rem;
	}
	.status p:empty {
		display: none;
	}
	.status:not(:has(p:not(:empty))) {
		display: none;
	}
	.error {
		margin: 0;
		color: var(--error);
		font-size: 0.9375rem;
		font-weight: 600;
	}
	.notice {
		margin: 0;
		padding: 1rem 1.25rem;
		border: 1px solid var(--accent);
		border-radius: 0.75rem;
		background: var(--surface);
	}
	.notice:focus {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.notice[hidden],
	button[hidden] {
		display: none;
	}
	.trap {
		position: absolute;
		left: -100vw;
	}
	button {
		justify-self: start;
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	@media (max-width: 40rem) {
		button {
			justify-self: stretch;
		}
	}
</style>
