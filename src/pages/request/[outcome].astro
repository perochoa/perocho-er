---
// Where the intake Worker sends people after they submit the form.
// Each outcome matches the Outcome type in worker/src/index.ts; add or remove them together.
import MessagePage from "../../components/MessagePage.astro";
import { site } from "../../site";

export function getStaticPaths() {
	return [
		{
			params: { outcome: "sent" },
			props: {
				title: "Request sent",
				text: "Thanks! We'll get back to you soon with a price and to confirm the time.",
				retry: false,
			},
		},
		{
			params: { outcome: "taken" },
			props: {
				title: "That time was just taken",
				text: "Someone booked it a moment before you. Pick another time, or message us and we'll find one.",
				retry: true,
			},
		},
		{
			params: { outcome: "failed" },
			props: {
				title: "Your request didn't go through",
				text: "Something went wrong on our end, or a field was missing. Try again, or message us instead.",
				retry: true,
			},
		},
	];
}

const { title, text, retry } = Astro.props;
---

<MessagePage eyebrow="Request a repair" title={title} text={text}>
	{retry && <a class="button" href="/request/">Back to the form</a>}
	<a class={retry ? "button secondary" : "button"} href={retry ? site.messengerUrl : "/"}>
		{retry ? "Message us" : "Go to the home page"}
	</a>
</MessagePage>
