---
// Where the intake Worker sends people after they submit the form. Keyed by the worker's outcomes,
// so `astro check` fails when one has no page.
import type { Outcome } from "../../../worker/src/outcomes";
import MessagePage from "../../components/MessagePage.astro";
import { site } from "../../site";

export function getStaticPaths() {
	const pages: Record<Outcome, { title: string; text: string; retry: boolean }> = {
		sent: {
			title: "Request sent",
			text: "Thanks! We've emailed you a copy, and we'll email you again when a tech confirms your drop-off time. A tech may call you about the price, and will let you know when it's ready. No email? Check your spam folder.",
			retry: false,
		},
		// Other requests never close a time; it's now too soon, or a tech's calendar changed.
		closed: {
			title: "That time isn't open any more",
			text: "It's now too close to drop off then, or the tech's hours changed. Go back to the form and pick another time, or message us and we'll find one.",
			retry: true,
		},
		failed: {
			title: "Your request didn't go through",
			text: `Something went wrong on our end, or a field was missing. Try again, or message us on Messenger or email ${site.email} instead.`,
			retry: true,
		},
	};
	return Object.entries(pages).map(([outcome, props]) => ({ params: { outcome }, props }));
}

const { title, text, retry } = Astro.props;
---

<MessagePage eyebrow="Request a repair" title={title} text={text} mark={retry ? "drift" : "done"}>
	{retry && <a class="button" href="/request/">Back to the form</a>}
	<a class={retry ? "button secondary" : "button"} href={retry ? site.messengerUrl : "/"}>
		{retry ? "Message us" : "Go to the home page"}
	</a>
	{retry && <a class="button secondary" href={`mailto:${site.email}`}>Email us</a>}
</MessagePage>
