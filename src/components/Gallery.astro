---
// /repairs/: single photos and clips from the bench, newest first. Photos open full size; clips play
// in place, muted, and only load when played. Shows nothing until there are any.
import { getImage, Image } from "astro:assets";
import { getCollection } from "astro:content";

const photos = await Promise.all(
	(await getCollection("gallery"))
		.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
		.map(async ({ id, data }) => ({
			id,
			...data,
			// A clip's poster, or the photo's full-size link.
			full: await getImage({ src: data.photo, width: data.video ? 720 : 1600 }),
		})),
);
---

{
	photos.length > 0 && (
		<section id="gallery" class="band alt" aria-labelledby="gallery-title">
			<div class="wrap">
				<div data-reveal>
					<p class="eyebrow">Gallery</p>
					<h2 id="gallery-title">From the bench</h2>
				</div>
				<ul class="grid">
					{photos.map(({ id, photo, alt, caption, video, full }, i) => (
						<li data-reveal style={`--i: ${i % 4}`}>
							<figure>
								{video ? (
									<video
										src={video}
										poster={full.src}
										aria-label={alt}
										aria-describedby={`${id}-caption`}
										controls
										muted
										playsinline
										preload="none"
									/>
								) : (
									<a href={full.src} aria-describedby={`${id}-caption`}>
										<Image src={photo} alt={alt} width={480} />
									</a>
								)}
								<figcaption id={`${id}-caption`}>{caption}</figcaption>
							</figure>
						</li>
					))}
				</ul>
			</div>
		</section>
	)
}

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	figure {
		margin: 0;
	}
	a {
		display: block;
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: 0.5rem;
		transition: border-color 0.15s;
	}
	a:hover {
		border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
	}
	a :global(img) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		transition: scale 0.3s;
	}
	@media (prefers-reduced-motion: no-preference) {
		a:hover :global(img) {
			scale: 1.04;
		}
	}
	/* Clips are portrait: shown whole in the same 4:3 tile, on a dark backdrop. */
	video {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: contain;
		background: #0e1514;
		border: 1px solid var(--line);
		border-radius: 0.5rem;
		box-sizing: border-box;
	}
	figcaption {
		margin-top: 0.5rem;
		color: var(--muted);
		font-size: 0.9375rem;
	}
</style>
