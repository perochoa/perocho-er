---
// Home page: the Marketplace rating summary and buyers' reviews. Shows nothing while marketplace
// is unset.
import Rosette from "./Rosette.astro";
import { marketplace } from "../reviews";

const dayFormat = new Intl.DateTimeFormat("en-CA", { timeZone: "UTC", dateStyle: "long" });
---

{
	marketplace && (
		<section id="reviews" class="band alt" aria-labelledby="reviews-title">
			<div class="wrap">
				<div data-reveal>
					<p class="eyebrow">Reviews</p>
					<h2 id="reviews-title">What customers say</h2>
				</div>
				<div class="reviews">
					<div class="summary" data-reveal>
						<p class="score">
							<strong>{marketplace.stars.toFixed(1)}</strong>
							<span>
								<span class="stars" aria-hidden="true">{"★".repeat(marketplace.stars)}</span>
								<span>{marketplace.ratings} ratings on Facebook Marketplace</span>
							</span>
						</p>
						<p class="badge big">
							<Rosette />
							<span>
								<strong>Highly rated</strong>
								<span>4.5 stars or higher from at least 5 buyers</span>
							</span>
						</p>
						<h3>What customers pointed out</h3>
						<ul class="strengths">
							{marketplace.strengths.map(({ label, count }, i) => (
								<li style={`--share: ${count / marketplace!.ratings}; --i: ${i}`}>
									<span>{label}</span>
									<span class="count">{count}</span>
									<span class="bar" aria-hidden="true" />
								</li>
							))}
						</ul>
						<a class="ask" href={marketplace.url}>
							See the profile on Marketplace <span aria-hidden="true">→</span>
						</a>
					</div>
					<ul class="quotes">
						{marketplace.reviews.map((review, i) => (
							<li class="card quote" data-reveal style={`--i: ${i + 1}`}>
								<figure>
									<p class="stars" role="img" aria-label={`${review.stars} out of 5 stars`}>
										{"★".repeat(review.stars)}
									</p>
									<blockquote>
										<p>{review.text}</p>
									</blockquote>
									<figcaption>
										<span class="avatar" aria-hidden="true">{review.name[0]}</span>
										<span>
											<strong>{review.name}</strong>
											<time datetime={review.date}>{dayFormat.format(new Date(review.date))}</time>
										</span>
									</figcaption>
								</figure>
								<ul class="tags" aria-label="Pointed out">
									{review.notable.map((tag) => <li>{tag}</li>)}
								</ul>
								{/* Marketplace has no link to a single review; the profile lists them under "Reviews of". */}
								<a class="source" href={marketplace!.url}>
									<span class="visually-hidden">{review.name}'s review </span>On Facebook Marketplace{" "}
									<span aria-hidden="true">↗</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</div>
		</section>
	)
}

<style>
	.reviews {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
		gap: 1.5rem;
		align-items: start;
	}
	.summary {
		display: grid;
		gap: 1.25rem;
		padding: 1.5rem;
		border-radius: 0.75rem;
		background: var(--bg);
		border: 1px solid var(--line);
	}
	.summary > * {
		margin: 0;
	}
	.score {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.score > strong {
		font-family: var(--font-mono);
		font-size: 3rem;
		font-weight: 500;
		line-height: 1;
		color: var(--ink);
	}
	.score > span {
		display: grid;
		color: var(--muted);
		font-size: 0.9375rem;
	}
	.score .stars {
		font-size: 1.25rem;
	}
	.badge.big {
		gap: 0.75rem;
		padding: 0.625rem 1rem 0.625rem 0.625rem;
		border-radius: 0.75rem;
		font-weight: 400;
	}
	.badge.big :global(svg) {
		width: 2.25rem;
		height: 2.25rem;
	}
	.badge.big > span {
		display: grid;
		color: var(--muted);
	}
	.badge.big strong {
		color: var(--ink);
		font-size: 1rem;
	}
	.summary h3 {
		margin-bottom: -0.5rem;
		font-size: 0.9375rem;
	}
	.strengths {
		display: grid;
		gap: 0.75rem;
		padding: 0;
		list-style: none;
	}
	.strengths li {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.25rem;
		font-size: 0.9375rem;
	}
	.count {
		font-family: var(--font-mono);
		color: var(--muted);
	}
	.bar {
		grid-column: 1 / -1;
		height: 0.375rem;
		border-radius: 999px;
		background: var(--line);
		overflow: hidden;
	}
	.bar::before {
		content: "";
		display: block;
		height: 100%;
		border-radius: inherit;
		background: var(--accent);
		transform: scaleX(var(--share));
		transform-origin: left;
	}
	/* The bars fill in once the summary scrolls into view. */
	@media (prefers-reduced-motion: no-preference) {
		.bar::before {
			transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--i, 0) * 100ms + 0.2s);
		}
		:global(.reveal-on) .summary:not(:global(.is-in)) .bar::before {
			transform: scaleX(0);
		}
	}
	.summary .ask {
		margin-top: 0;
	}
	.quotes {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.quote figure {
		margin: 0;
	}
	.quote .stars {
		margin: 0;
		font-size: 0.9375rem;
	}
	.quote blockquote {
		margin: 0.5rem 0 1rem;
		font-size: 1.0625rem;
	}
	.quote blockquote p {
		margin: 0;
	}
	.quote blockquote p::before {
		content: "“";
	}
	.quote blockquote p::after {
		content: "”";
	}
	.quote figcaption {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--muted);
	}
	.quote figcaption > span:last-child {
		display: grid;
		font-size: 0.875rem;
	}
	.quote time {
		color: var(--muted);
	}
	.avatar {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 50%;
		background: color-mix(in srgb, var(--accent) 15%, var(--surface));
		color: var(--accent);
		font-weight: 700;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
	}
	.source {
		display: inline-flex;
		gap: 0.25rem;
		margin-top: 1rem;
		color: var(--muted);
		font-size: 0.8125rem;
		font-weight: 600;
		text-decoration: none;
		transition: color 0.15s;
	}
	.source:hover,
	.source:focus-visible {
		color: var(--accent);
	}
	.source span[aria-hidden] {
		transition: transform 0.2s;
	}
	.source:hover span[aria-hidden] {
		transform: translate(2px, -2px);
	}
	.tags li {
		padding: 0.125rem 0.625rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--accent) 9%, transparent);
		color: var(--accent);
		font-size: 0.8125rem;
		font-weight: 600;
	}

	@media (max-width: 48rem) {
		.reviews {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
