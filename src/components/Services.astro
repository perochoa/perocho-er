---
// Home page: the service cards, with a price calculator on per-item ones.
import { type CollectionEntry, render } from "astro:content";
import { site } from "../site";

interface Props {
	services: CollectionEntry<"services">[];
}

const renderedServices = await Promise.all(
	Astro.props.services.map(async (service) => ({ ...service, Content: (await render(service)).Content })),
);

// Per-item services build their price line from the calculator's numbers, so the two can't disagree.
const priceText = ({ price, perItem }: CollectionEntry<"services">["data"]) =>
	price ??
	(perItem
		? `$${perItem.price} per ${perItem.item}, or $${perItem.bulkPrice} per ${perItem.item} for ${perItem.bulkFrom} or more`
		: "Message us for a quote");
---

<section id="services" class="band" aria-labelledby="services-title">
	<div class="wrap">
		<div data-reveal>
			<p class="eyebrow">Services</p>
			<h2 id="services-title">What we fix</h2>
		</div>
		<ul class="cards">
			{
				renderedServices.map(({ id, data, Content }, i) => (
					<li class="card" data-reveal style={`--i: ${i}`}>
						<h3>{data.title}</h3>
						<div class="body">
							<Content />
						</div>
						{data.perItem && (
							<div
								class="calc"
								data-price={data.perItem.price}
								data-bulk-price={data.perItem.bulkPrice}
								data-bulk-from={data.perItem.bulkFrom}
								data-item={data.perItem.item}
								hidden
							>
								<span class="calc-label" id={`calc-${id}`}>
									How many {data.perItem.item}s?
								</span>
								<div class="stepper" role="group" aria-labelledby={`calc-${id}`}>
									<button type="button" data-step="-1" aria-label={`One ${data.perItem.item} fewer`}>
										−
									</button>
									<output data-count>2</output>
									<button type="button" data-step="1" aria-label={`One ${data.perItem.item} more`}>
										+
									</button>
								</div>
								<p class="calc-total" aria-live="polite">
									<strong data-total />
									<span data-note />
								</p>
							</div>
						)}
						<p class="price">{priceText(data)}</p>
						{site.intakeUrl && (
							<a class="ask" href={`/request/?service=${id}`}>
								Request this repair <span aria-hidden="true">→</span>
							</a>
						)}
					</li>
				))
			}
		</ul>
	</div>
</section>

<script>
	// Price calculator on cards whose service is priced per item (the stick drift fix).
	const money = (n: number) => `$${n}`;
	document.querySelectorAll<HTMLElement>(".calc").forEach((calc) => {
		const price = Number(calc.dataset.price);
		const bulkPrice = Number(calc.dataset.bulkPrice);
		const bulkFrom = Number(calc.dataset.bulkFrom);
		const item = calc.dataset.item!;
		const output = calc.querySelector<HTMLOutputElement>("[data-count]")!;
		const total = calc.querySelector<HTMLElement>("[data-total]")!;
		const note = calc.querySelector<HTMLElement>("[data-note]")!;
		const minus = calc.querySelector<HTMLButtonElement>('[data-step="-1"]')!;
		const MAX = 12;
		let count = Number(output.value);

		const render = () => {
			const each = count >= bulkFrom ? bulkPrice : price;
			output.textContent = String(count);
			total.textContent = money(count * each);
			const more = bulkFrom - count;
			note.textContent =
				more > 0
					? ` · ${more} more ${more === 1 ? item : `${item}s`} and they're ${money(bulkPrice)} each`
					: ` · ${money(each)} each, you save ${money(count * (price - bulkPrice))}`;
			minus.disabled = count <= 1;
			total.classList.remove("bump");
			// Restart the animation on every change.
			void total.offsetWidth;
			total.classList.add("bump");
		};

		calc.addEventListener("click", (event) => {
			const step = (event.target as Element).closest<HTMLButtonElement>("[data-step]");
			if (!step) return;
			count = Math.min(MAX, Math.max(1, count + Number(step.dataset.step)));
			render();
		});
		calc.hidden = false;
		render();
	});
</script>

<style>
	.card .body {
		flex: 1;
		color: var(--muted);
	}
	.card .body :global(strong) {
		color: var(--ink);
	}
	.card .body :global(ul) {
		padding-left: 1.125rem;
	}
	.card .body :global(li + li) {
		margin-top: 0.375rem;
	}
	.price {
		margin: 1.25rem 0 0;
		padding-top: 1rem;
		border-top: 1px solid var(--line);
		font-family: var(--font-mono);
		font-weight: 500;
		color: var(--accent);
	}

	/* Price calculator */
	.calc {
		display: grid;
		grid-template-columns: auto auto;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		margin-top: 1.25rem;
		padding: 0.875rem 1rem;
		border-radius: 0.625rem;
		background: color-mix(in srgb, var(--accent) 7%, var(--bg));
		border: 1px solid color-mix(in srgb, var(--accent) 20%, var(--line));
	}
	.calc[hidden] {
		display: none;
	}
	.calc-label {
		font-weight: 600;
		font-size: 0.9375rem;
	}
	.stepper {
		display: flex;
		align-items: center;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--surface);
	}
	.stepper button {
		width: 2.25rem;
		height: 2.25rem;
		border: 0;
		border-radius: 50%;
		background: none;
		color: var(--accent);
		font: inherit;
		font-size: 1.25rem;
		line-height: 1;
		cursor: pointer;
		transition: background-color 0.15s;
	}
	.stepper button:hover:not(:disabled) {
		background: color-mix(in srgb, var(--accent) 12%, transparent);
	}
	.stepper button:disabled {
		color: var(--muted);
		opacity: 0.5;
		cursor: default;
	}
	.stepper output {
		min-width: 2ch;
		font-family: var(--font-mono);
		font-weight: 500;
		text-align: center;
	}
	.calc-total {
		grid-column: 1 / -1;
		margin: 0;
		color: var(--muted);
		font-size: 0.875rem;
	}
	.calc-total strong {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 1.25rem;
		font-weight: 500;
		color: var(--ink);
	}
	@media (prefers-reduced-motion: no-preference) {
		.calc-total :global(.bump) {
			animation: bump 0.3s ease-out;
		}
	}
	@keyframes bump {
		40% {
			transform: scale(1.15);
			color: var(--accent);
		}
	}
</style>
