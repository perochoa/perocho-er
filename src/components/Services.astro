---
// Home page: the service cards, each with a photo across the top.
import { Image } from "astro:assets";
import { type CollectionEntry, render } from "astro:content";
import { priceText } from "../services";
import { site } from "../site";

interface Props {
	services: CollectionEntry<"services">[];
}

const renderedServices = await Promise.all(
	Astro.props.services.map(async (service) => ({ ...service, Content: (await render(service)).Content })),
);
---

<section id="services" class="band" aria-labelledby="services-title">
	<div class="wrap">
		<div data-reveal>
			<p class="eyebrow">Services</p>
			<h2 id="services-title">What we fix</h2>
		</div>
		<ul class="cards">
			{
				renderedServices.map(({ id, data, Content }, i) => (
					<li class="card" data-reveal style={`--i: ${i}`}>
						{data.photo && <Image class="photo" src={data.photo} alt="" width={720} />}
						<h3>{data.title}</h3>
						<div class="body">
							<Content />
						</div>
						<p class="price">{priceText(data)}</p>
						{site.intakeUrl && (
							<a class="ask" href={`/request/?service=${id}`}>
								Request this repair <span aria-hidden="true">→</span>
							</a>
						)}
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	/* Bleeds to the card's edges and fades out under the title, so the text never sits on the photo. */
	.card :global(.photo) {
		display: block;
		width: calc(100% + 3rem);
		max-width: none;
		height: 7.5rem;
		margin: -1.5rem -1.5rem -1.25rem;
		object-fit: cover;
		border-radius: calc(0.75rem - 1px) calc(0.75rem - 1px) 0 0;
		mask-image: linear-gradient(to bottom, #000 30%, transparent 85%);
	}
	.card .body {
		flex: 1;
		color: var(--muted);
	}
	.card .body :global(p) {
		margin: 0 0 0.75rem;
	}
	.card .body :global(p:last-child) {
		margin-bottom: 0;
	}
	.card .body :global(strong) {
		color: var(--ink);
	}
	.card .body :global(ul) {
		padding-left: 1.125rem;
	}
	.card .body :global(li + li) {
		margin-top: 0.375rem;
	}
	.price {
		margin: 1rem 0 0;
		padding-top: 0.75rem;
		border-top: 1px solid var(--line);
		font-family: var(--font-mono);
		font-weight: 500;
		color: var(--accent);
	}
</style>
