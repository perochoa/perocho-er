---
// Home page: how a repair goes, from request to pickup.
import { site } from "../site";

// Matches what the request form and the worker's emails tell customers.
const steps = site.intakeUrl
	? [
			{
				title: "Request a repair",
				text: "Fill in the form with your contact details and phone number, the device and what's wrong.",
			},
			{
				title: "Pick a drop-off time",
				text: `Choose any open time to bring it in. Need it sooner? Add a rush for $${site.rushFee} to move it to the front of the line.`,
			},
			{
				title: "Get it confirmed",
				text: "A tech reviews your request and confirms it by email, and may call you about the quote. If nobody can take it, we email you too.",
			},
			{
				title: "Drop it off",
				text: "Bring it in at your drop-off time. We work in order, rush first, and agree with you on when it'll be ready. Pay by cash or Interac e-Transfer at pickup.",
			},
		]
	: [
			{ title: "Message us", text: "On Messenger or by email, about your device and what's wrong." },
			{ title: "Get a quote", text: "We reply with a price and a time to drop it off." },
			{ title: "Drop it off", text: "Bring it in at the time we agreed. We'll tell you when it'll be ready." },
			{ title: "Pay on pickup", text: "By cash or Interac e-Transfer." },
		];
---

<section id="how" class="band" aria-labelledby="how-title">
	<div class="wrap">
		<div data-reveal>
			<p class="eyebrow">How it works</p>
			<h2 id="how-title">From request to pickup</h2>
		</div>
		<ol class="steps">
			{
				steps.map((step, i) => (
					<li data-reveal style={`--i: ${i}`}>
						<h3>{step.title}</h3>
						<p>{step.text}</p>
					</li>
				))
			}
		</ol>
		{
			site.intakeUrl && (
				<p class="next" data-reveal>
					<a class="button" href="/request/">Request a repair</a>
					<span>
						Questions first? <a href={site.messengerUrl}>Message us</a>.
					</span>
				</p>
			)
		}
	</div>
</section>

<style>
	.steps {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		counter-reset: step;
	}
	.steps li {
		position: relative;
		counter-increment: step;
		padding-top: 3.5rem;
	}
	.steps li::before {
		content: counter(step, decimal-leading-zero);
		position: absolute;
		top: 0;
		left: 0;
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		background: var(--accent);
		color: var(--on-accent);
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: 0.875rem;
	}
	/* Connector between step markers. */
	.steps li:not(:last-child)::after {
		content: "";
		position: absolute;
		top: 1.25rem;
		left: 3.25rem;
		right: -0.75rem;
		border-top: 2px dashed var(--line);
	}
	@media (prefers-reduced-motion: no-preference) {
		.steps li::after {
			transform-origin: left;
			transition: transform 0.6s ease-out calc(var(--i, 0) * 80ms + 0.3s);
		}
		:global(.reveal-on) .steps li:not(:global(.is-in))::after {
			transform: scaleX(0);
		}
		.steps li::before {
			transition: transform 0.4s cubic-bezier(0.3, 1.6, 0.5, 1) calc(var(--i, 0) * 80ms);
		}
		:global(.reveal-on) .steps li:not(:global(.is-in))::before {
			transform: scale(0.4);
		}
		.steps li:hover::before {
			transform: scale(1.1);
		}
	}
	.steps h3 {
		margin: 0 0 0.375rem;
	}
	.steps p {
		margin: 0;
		color: var(--muted);
	}
	.next {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
		margin: 2.5rem 0 0;
		color: var(--muted);
	}

	@media (max-width: 56rem) {
		.steps {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			row-gap: 2rem;
		}
		.steps li:nth-child(2)::after {
			display: none;
		}
	}
	@media (max-width: 30rem) {
		.steps {
			grid-template-columns: minmax(0, 1fr);
		}
		.steps li::after {
			display: none;
		}
		/* One column: the marker sits beside its step instead of above it. */
		.steps li {
			padding: 0.5rem 0 0 3.5rem;
		}
		/* Full-width button like the other sections, with the Messenger line centred under it. */
		.next .button {
			flex-basis: 100%;
		}
		.next span {
			flex-basis: 100%;
			text-align: center;
		}
	}
</style>
