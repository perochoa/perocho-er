---
// Home page: the newest before-and-after repairs, linking to /repairs/ for the rest and the gallery.
// Shows nothing until there are any.
import RepairCard from "./RepairCard.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
	// Newest first.
	repairs: CollectionEntry<"repairs">[];
}

const { repairs } = Astro.props;
---

{
	repairs.length > 0 && (
		<section id="repairs" class="band" aria-labelledby="repairs-title">
			<div class="wrap">
				<div data-reveal>
					<p class="eyebrow">Past repairs</p>
					<h2 id="repairs-title">Before and after</h2>
				</div>
				<ul class="cards">
					{repairs.slice(0, 3).map((repair, i) => (
						<RepairCard repair={repair} i={i} />
					))}
				</ul>
				<a class="ask" href="/repairs/">
					See every repair and more photos from the bench <span aria-hidden="true">→</span>
				</a>
			</div>
		</section>
	)
}

<style>
	.ask {
		margin-top: 1.5rem;
	}
</style>
