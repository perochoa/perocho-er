---
// Home page: the ways to get in touch, with a copy button for the email address.
import { marketplace } from "../reviews";
import { site } from "../site";
---

<section id="contact" class="band" aria-labelledby="contact-title">
	<div class="wrap">
		<div class="contact" data-reveal>
			<div>
				<p class="eyebrow">Contact</p>
				<h2 id="contact-title">Tell us what's wrong</h2>
				<p>
					{
						site.intakeUrl ? (
							<>
								<a href="/request/">Send a repair request</a> and pick a drop-off time, or ask us
								anything first on <a href={site.messengerUrl}>Messenger</a> or at{" "}
								<a href={`mailto:${site.email}`}>{site.email}</a>.
							</>
						) : (
							<>
								<a href={site.messengerUrl}>Message us on Messenger</a> or email{" "}
								<a href={`mailto:${site.email}`}>{site.email}</a>.
							</>
						)
					}{" "}
					{
						marketplace && (
							<>
								See our listings and reviews on{" "}
								<a href={marketplace.url}>Facebook Marketplace</a>.
							</>
						)
					}
				</p>
				<div class="actions">
					{site.intakeUrl && <a class="button" href="/request/">Request a repair</a>}
					<a class={site.intakeUrl ? "button secondary" : "button"} href={site.messengerUrl}>
						Message us
					</a>
					<span class="email">
						<a class="button secondary" href={`mailto:${site.email}`}>Email us</a>
						<button class="button secondary copy" type="button" data-copy={site.email} aria-label="Copy email address" hidden>
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<g class="clip">
									<rect x="8" y="8" width="12" height="12" rx="2" />
									<path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" />
								</g>
								<path class="tick" d="M5 12.5l4.5 4.5L19 7.5" />
							</svg>
						</button>
					</span>
				</div>
				<p class="visually-hidden" data-copy-status aria-live="polite"></p>
			</div>
			{
				(site.serviceArea || site.hours) && (
					<dl class="details">
						{site.serviceArea && (
							<div>
								<dt>Where</dt>
								<dd>{site.serviceArea}</dd>
							</div>
						)}
						{site.hours && (
							<div>
								<dt>When</dt>
								<dd>{site.hours}</dd>
							</div>
						)}
					</dl>
				)
			}
		</div>
	</div>
</section>

<script>
	// Copy-email, for desktops without a mail app.
	document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
		if (!navigator.clipboard) return;
		const status = button.closest(".contact")?.querySelector<HTMLElement>("[data-copy-status]");
		let timer = 0;
		button.hidden = false;
		button.addEventListener("click", async () => {
			try {
				await navigator.clipboard.writeText(button.dataset.copy!);
				button.classList.add("is-copied");
				if (status) status.textContent = `Copied ${button.dataset.copy} to the clipboard.`;
			} catch {
				if (status) status.textContent = "Couldn't copy the email address.";
			}
			clearTimeout(timer);
			timer = window.setTimeout(() => {
				button.classList.remove("is-copied");
				if (status) status.textContent = "";
			}, 2000);
		});
	});
</script>

<style>
	.contact {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
		gap: 2.5rem;
		padding: clamp(1.5rem, 1rem + 3vw, 3rem);
		border-radius: 1rem;
		background: color-mix(in srgb, var(--accent) 9%, var(--surface));
		border: 1px solid color-mix(in srgb, var(--accent) 25%, var(--line));
	}
	.contact h2 {
		margin-bottom: 1rem;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}
	/* "Email us" and the copy button read as one split button. */
	.email {
		display: inline-flex;
	}
	.email > .button:first-child:not(:only-child) {
		border-top-right-radius: 0;
		border-bottom-right-radius: 0;
	}
	.email .button {
		flex: 1;
	}
	.copy {
		margin-left: -1px;
		padding-inline: 0.75rem;
		border-top-left-radius: 0;
		border-bottom-left-radius: 0;
		font: inherit;
		cursor: pointer;
	}
	.copy[hidden] {
		display: none;
	}
	.copy svg {
		width: 1.125rem;
		height: 1.125rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.copy .clip,
	.copy .tick {
		transition:
			opacity 0.2s,
			transform 0.2s;
		transform-origin: center;
	}
	.copy .tick {
		opacity: 0;
		transform: scale(0.5);
	}
	.copy.is-copied {
		border-color: var(--accent);
		color: var(--accent);
	}
	.copy.is-copied .clip {
		opacity: 0;
		transform: scale(0.5);
	}
	.copy.is-copied .tick {
		opacity: 1;
		transform: none;
	}
	.details {
		display: grid;
		align-content: start;
		gap: 0.75rem;
		margin: 0;
		padding: 1.5rem;
		border-radius: 0.75rem;
		background: var(--surface);
		border: 1px solid var(--line);
	}
	dt {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}
	dd {
		margin: 0.125rem 0 0;
	}

	@media (max-width: 48rem) {
		.contact {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	@media (max-width: 30rem) {
		.actions .button,
		.actions .email {
			flex: 1;
		}
		.actions .copy {
			flex: none;
		}
		/* One button per row: whether two fit side by side depends on the phone's exact width
		   (402px fits "Message us" next to a squeezed "Email us"; 390px doesn't). */
		.contact .actions {
			display: grid;
		}
	}
</style>
