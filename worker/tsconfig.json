// Worker code only, without Node types: the Worker has no nodejs_compat. Tests, which run in Node,
// use tsconfig.test.json; `npm run check` checks both.
{
	"compilerOptions": {
		"target": "es2024",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2024"],
		"types": ["./worker-configuration.d.ts"],
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["src"],
	"exclude": ["src/**/*.test.ts"]
}
