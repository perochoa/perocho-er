{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "perocho-intake",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"observability": { "enabled": true },
	// Set with `npx wrangler secret put <NAME>`; tech names and calendar IDs stay out of the public repo.
	//   TECHS                   [{"name": "Richard", "calendarId": "richard@gmail.com", "email": "..."}, ...]
	//   GOOGLE_SERVICE_ACCOUNT  the service account's JSON key
	//   FASTMAIL_TOKEN          API token with Email and Email submission access
	// Listing them here types them in worker-configuration.d.ts and makes deploy fail if one is unset.
	"secrets": { "required": ["TECHS", "GOOGLE_SERVICE_ACCOUNT", "FASTMAIL_TOKEN"] },
	// Per visitor IP per minute (period is 10 or 60 seconds): valid form posts, and /slots fetches.
	// Counted per Cloudflare location and approximate. namespace_id is any number unique in the account.
	"ratelimits": [
		{ "name": "REQUEST_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
		{ "name": "SLOTS_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
	],
	// Requests and their offers to the techs (migrations/). Created with
	// `npx wrangler d1 create perocho-intake`; the deploy job applies new migrations first.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "perocho-intake",
			"database_id": "b7ed3a0c-2280-4244-abc1-d8693bb0a9c5"
		}
	],
	"vars": {
		"SITE_URL": "https://repairs.perocho.com",
		"MAIL_FROM": "contact@perocho.com",
		"MAIL_TO": "contact@perocho.com",
		"TIME_ZONE": "America/Toronto",
		"SLOT_MINUTES": 60,
		"LEAD_HOURS": 2,
		"DAYS_AHEAD": 31,
		// Comma-separated origins also allowed to read /slots, besides SITE_URL. Leave empty here;
		// set it in .dev.vars for local work, e.g. DEV_ORIGINS=http://localhost:4321
		"DEV_ORIGINS": ""
	}
}
